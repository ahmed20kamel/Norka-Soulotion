# Copy this file to .env.local for local development.
# In production (Vercel), set these under Project Settings → Environment Variables.

# Powers the AI chat widget (src/app/api/chat/route.ts)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Powers the contact form email delivery (src/app/api/contact/route.ts)
# Get a key at https://resend.com
RESEND_API_KEY=

# Where contact form submissions are sent. Defaults to info@norkasolution.com if unset.
CONTACT_EMAIL=info@norkasolution.com

# WhatsApp number used by the floating WhatsApp button (digits only, with country code).
# Defaults to 971507257157 if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=971507257157

# Optional headless CMS (Sanity) for projects/services copy/testimonials.
# Leave all three empty to keep using src/lib/data/*.ts + src/messages/*.json
# unchanged — see the "Content / CMS" section in README.md for full setup.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
